<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your ThriveWoo POS Subscription Renewal Receipt</title>
</head>
<body style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 24px; background-color: #f1f5f9; color: #1e293b; margin: 0;">
  <div style="max-width: 600px; margin: 0 auto; background: #ffffff; padding: 32px 28px; border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;">
    
    <!-- Header Branding -->
    <div style="text-align: center; margin-bottom: 26px; border-bottom: 1px solid #f1f5f9; padding-bottom: 20px;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 14px; color: #ffffff; font-size: 26px; font-weight: 800; margin-bottom: 10px;">
        ✓
      </div>
      <h2 style="margin: 0; font-size: 22px; font-weight: 800; color: #0f172a;">ThriveWoo POS</h2>
      <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">Subscription Renewal Confirmation &amp; Receipt</p>
    </div>

    <!-- Greeting -->
    <h3 style="color: #0f172a; font-size: 18px; font-weight: 700; margin-top: 0;">
      Hello <%= name %>,
    </h3>

    <!-- Success Confirmation Banner -->
    <div style="background: #ecfdf5; border-left: 4px solid #10b981; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px;">
      <strong style="color: #065f46; font-size: 15px;">🎉 Subscription Successfully Renewed</strong>
      <p style="margin: 6px 0 0; color: #047857; font-size: 14px; line-height: 1.5;">
        Thank you for continuing with ThriveWoo POS! Your payment for the <strong><%= plan_name %></strong> plan has been processed successfully. Your store checkout registers and cloud sync remain fully active with zero interruption.
      </p>
    </div>

    <!-- Receipt / Transaction Details Card -->
    <div style="background: #f8fafc; border-radius: 10px; padding: 20px; margin: 24px 0; border: 1px solid #e2e8f0;">
      <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.05em; margin-bottom: 12px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
        Payment Receipt &amp; Plan Details
      </div>
      <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
        <tr>
          <td style="padding: 7px 0; color: #64748b; font-weight: 600;">Store / Business Name:</td>
          <td style="padding: 7px 0; text-align: right; color: #0f172a; font-weight: 700;"><%= store_name %></td>
        </tr>
        <tr>
          <td style="padding: 7px 0; color: #64748b; font-weight: 600;">Subscription Tier:</td>
          <td style="padding: 7px 0; text-align: right; color: #4f46e5; font-weight: 700;"><%= plan_name %> Plan (<%= billing_cycle %>)</td>
        </tr>
        <tr>
          <td style="padding: 7px 0; color: #64748b; font-weight: 600;">Amount Paid:</td>
          <td style="padding: 7px 0; text-align: right; color: #059669; font-weight: 800; font-size: 16px;">$<%= amount %> <%= currency %></td>
        </tr>
        <tr>
          <td style="padding: 7px 0; color: #64748b; font-weight: 600;">Payment Method:</td>
          <td style="padding: 7px 0; text-align: right; color: #0f172a; font-weight: 600;"><%= payment_method %></td>
        </tr>
        <tr>
          <td style="padding: 7px 0; color: #64748b; font-weight: 600;">Transaction Reference:</td>
          <td style="padding: 7px 0; text-align: right; color: #0f172a; font-family: monospace; font-size: 13px;"><%= transaction_id %></td>
        </tr>
        <tr>
          <td style="padding: 7px 0; color: #64748b; font-weight: 600;">Renewal Date:</td>
          <td style="padding: 7px 0; text-align: right; color: #0f172a; font-weight: 600;"><%= renewal_date %></td>
        </tr>
        <tr>
          <td style="padding: 7px 0; color: #64748b; font-weight: 600;">Next Billing Date:</td>
          <td style="padding: 7px 0; text-align: right; color: #0f172a; font-weight: 700;"><%= next_billing_date %></td>
        </tr>
      </table>
    </div>

    <!-- Active Features / Benefit Summary -->
    <div style="background: #f8fafc; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px; font-size: 13.5px; color: #475569; border: 1px dashed #cbd5e1;">
      <p style="margin: 0; font-weight: 600; color: #1e293b; margin-bottom: 6px;">Your Active Plan Includes:</p>
      <ul style="margin: 0; padding-left: 18px; line-height: 1.6;">
        <li>Full Multi-Terminal Barcode &amp; Touch POS</li>
        <li>Real-Time WooCommerce &amp; Web Store Catalog Sync</li>
        <li>Pine Labs &amp; Integrated Card Reader Terminal Support</li>
        <li>Staff Shift Logs, Held Carts &amp; Day-End Reconciliation</li>
      </ul>
    </div>

    <!-- Call to Action -->
    <div style="text-align: center; margin: 30px 0 20px;">
      <a href="<%= login_url %>" style="display: inline-block; padding: 13px 34px; background: #059669; color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 700; font-size: 15px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);">
        Launch POS Dashboard
      </a>
    </div>

    <!-- Footer Note -->
    <div style="text-align: center; border-top: 1px solid #f1f5f9; padding-top: 20px; font-size: 12px; color: #94a3b8; line-height: 1.5;">
      <p style="margin: 0;">This email serves as your official payment receipt for ThriveWoo POS.</p>
      <p style="margin: 4px 0 0;">Need help or have questions about your billing? Contact us at <a href="mailto:support@thrivewoo.com" style="color: #4f46e5; text-decoration: none;">support@thrivewoo.com</a>.</p>
    </div>

  </div>
</body>
</html>
